# Copy to .env and fill in. .env is gitignored — never commit real keys.
# Get these from https://dashboard.plaid.com/developers/keys

PLAID_CLIENT_ID=
PLAID_SECRET=

# sandbox = fake banks, free, works immediately (start here)
# production = your real bank; requires Plaid production access approval
PLAID_ENV=sandbox

# Shown inside the bank's login screen during Link
PLAID_CLIENT_NAME=Debit Ledger

# Plaid Trial plan: 10 connected banks ("Items"), unlimited API calls.
# Disconnecting a bank does NOT give the slot back. 0 = no cap (paid Production).
PLAID_ITEM_LIMIT=10

# Only for legacy Limited Production accounts, which metered calls instead.
# 0 disables the call cap entirely (correct for Trial and Production).
PLAID_CALL_BUDGET=0

# Required before the app will accept ANY connection from outside this machine
# (e.g. through a Cloudflare Tunnel). Leave blank and remote access is refused.
# Make it long — this is the only thing between the internet and your bank data.
APP_PASSWORD=

PORT=4310
